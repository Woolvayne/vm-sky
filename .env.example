# Datenbank (bereits vorkonfiguriert in der Sandbox)
DATABASE_URL=postgresql://postgres:postgres@127.0.0.1:5432/app_db

# Upstream-Reseller-API (VMSky) – Zugangsdaten aus deinem Vertrag.
# Ohne Key läuft der Shop im Sandbox-Modus: Bestellungen werden nur
# lokal gespeichert (Status "pending") und können manuell provisioniert werden.
VMSKY_API_BASE=https://api.vmsky.de/v1
VMSKY_API_KEY=
